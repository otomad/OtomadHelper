<TextBox
	x:Class="OtomadHelper.WPF.Controls.NumericUpDown"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:OtomadHelper.WPF.Controls"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:m="clr-namespace:OtomadHelper.WPF.Common"
	Style="{DynamicResource DefaultTextBoxStyle}"
	c:NumericUpDown.ShowSpinner="True"
	m:NumberTextBoxBehavior.NumberInputMode="Integer"
	>
	<i:Interaction.Behaviors>
		<m:NumberTextBoxBehavior />
		<m:NumberTextBoxUpDownKeyBehavior />
	</i:Interaction.Behaviors>
</TextBox>
