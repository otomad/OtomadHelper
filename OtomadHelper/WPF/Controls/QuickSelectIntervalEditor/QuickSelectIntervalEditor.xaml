<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:OtomadHelper.WPF.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:m="clr-namespace:OtomadHelper.WPF.Common"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	>
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/OtomadHelper;component/WPF/Themes/Generic.xaml" />
		<ResourceDictionary Source="pack://application:,,,/OtomadHelper;component/WPF/Themes/Controls.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<c:AddOneConverter x:Key="AddOne" />
	<c:CountToViewportConverter x:Key="CountToViewport" />
	<c:CountToVisualBrushWidthConverter x:Key="CountToWidth" />

	<Style TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style TargetType="c:Icon">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="Size" Value="20" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,7,0" />
	</Style>

	<Style x:Key="FormIconAndLabel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="m:InteractivityItems.Template">
			<Setter.Value>
				<m:InteractivityTemplate>
					<m:InteractivityItems>
						<m:InteractivityItems.Behaviors>
							<m:ClickLabelToFocusTextBoxBehavior />
						</m:InteractivityItems.Behaviors>
					</m:InteractivityItems>
				</m:InteractivityTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
		<Setter Property="Width" Value="{x:Static c:QuickSelectInterval1DEditor.ToggleButtonSize}" />
		<Setter Property="Height" Value="{x:Static c:QuickSelectInterval1DEditor.ToggleButtonSize}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Right="{x:Static c:QuickSelectInterval1DEditor.ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="HorizontalStackPanel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
	</Style>

	<Style x:Key="VerticalStackPanel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Vertical" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
	</Style>

	<Style x:Key="HorizontalStackPanelInsideVertical" BasedOn="{StaticResource HorizontalStackPanel}" TargetType="StackPanel">
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Bottom="{x:Static c:QuickSelectInterval1DEditor.ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ActionButtonsGrid" TargetType="UniformGrid">
		<Setter Property="Columns" Value="3" />
		<Setter Property="Grid.ColumnSpan" Value="3" />
		<Setter Property="m:Spacing.Horizontal" Value="6" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Style.Resources>
			<Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="c:Button">
				<Setter Property="MinWidth" Value="100" />
			</Style>
		</Style.Resources>
	</Style>

	<Style x:Key="RightTileShadow" TargetType="Rectangle">
		<Setter Property="Margin" Value="-2,0,0,0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="No" />
	</Style>

	<Style x:Key="RowLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Width" Value="{x:Static c:QuickSelectInterval1DEditor.ToggleButtonSize}" />
		<Setter Property="Padding" Value="0,0,8,0" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
	</Style>
</ResourceDictionary>
