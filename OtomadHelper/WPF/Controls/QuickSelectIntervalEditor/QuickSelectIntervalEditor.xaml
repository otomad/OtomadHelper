<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:OtomadHelper.WPF.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:m="clr-namespace:OtomadHelper.WPF.Common"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	>
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/OtomadHelper;component/WPF/Themes/Generic.xaml" />
		<ResourceDictionary Source="pack://application:,,,/OtomadHelper;component/WPF/Themes/Controls.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<c:AddOneConverter x:Key="AddOne" />
	<c:CountToInlineViewportConverter x:Key="CountToXViewport" />
	<c:CountToBlockViewportConverter x:Key="CountToYViewport" />
	<c:CountToVisualBrushSizeConverter x:Key="CountToSize" />
	<c:AlternationIndexToRowCellConverter x:Key="IndexToRowCell" />
	<c:CountToCollectionConverter x:Key="CountToCollection" />
	<m:ScrollViewerScrollBarVisibilityToScrollBarThicknessMarginConverter x:Key="ScrollViewerVisToMargin" />
	<c:ContentWidthToIsWideConverter x:Key="WidthToWide" />

	<x:Static x:Key="ToggleButtonSize" Member="c:QuickSelectInterval1DEditor.ToggleButtonSize" />
	<x:Static x:Key="ToggleButtonSpacing" Member="c:QuickSelectInterval1DEditor.ToggleButtonSpacing" />

	<Style TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style TargetType="c:Icon">
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="Size" Value="20" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,7,0" />
	</Style>

	<Style x:Key="FormIconAndLabel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="m:InteractivityItems.Template">
			<Setter.Value>
				<m:InteractivityTemplate>
					<m:InteractivityItems>
						<m:InteractivityItems.Behaviors>
							<m:ClickLabelToFocusTextBoxBehavior />
						</m:InteractivityItems.Behaviors>
					</m:InteractivityItems>
				</m:InteractivityTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
		<Setter Property="Width" Value="{StaticResource ToggleButtonSize}" />
		<Setter Property="Height" Value="{StaticResource ToggleButtonSize}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Right="{StaticResource ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="HorizontalStackPanel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
	</Style>

	<Style x:Key="VerticalStackPanel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Vertical" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
	</Style>

	<Style x:Key="HorizontalStackPanelInsideVertical" BasedOn="{StaticResource HorizontalStackPanel}" TargetType="StackPanel">
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Bottom="{StaticResource ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ActionButtonsGrid" TargetType="UniformGrid">
		<Setter Property="Columns" Value="3" />
		<Setter Property="Grid.ColumnSpan" Value="3" />
		<Setter Property="m:Spacing.Horizontal" Value="6" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Style.Resources>
			<Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="c:Button">
				<Setter Property="MinWidth" Value="100" />
			</Style>
		</Style.Resources>
	</Style>

	<Style x:Key="RightTileShadow" TargetType="Rectangle">
		<Setter Property="Margin" Value="0,0,0,-4" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="No" />
	</Style>

	<Style x:Key="BottomTileShadow" TargetType="Rectangle">
		<Setter Property="Margin" Value="0" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="No" />
	</Style>

	<Style x:Key="ColumnLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
		<Setter Property="TextAlignment" Value="Center" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Width" Value="{StaticResource ToggleButtonSize}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Right="{StaticResource ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RowLabel" TargetType="Border">
		<Setter Property="Height" Value="{StaticResource ToggleButtonSize}" />
		<Setter Property="BorderBrush" Value="{x:Null}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Margin">
			<Setter.Value>
				<Thickness Bottom="{StaticResource ToggleButtonSpacing}" />
			</Setter.Value>
		</Setter>
		<Style.Resources>
			<Style BasedOn="{StaticResource ColumnLabel}" TargetType="TextBlock">
				<Setter Property="TextAlignment" Value="Right" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="Width" Value="Auto" />
				<Setter Property="Margin" Value="0" />
			</Style>
		</Style.Resources>
	</Style>

	<Style TargetType="ItemsControl">
		<Setter Property="Focusable" Value="False" />
	</Style>

	<Style x:Key="ColumnLabels" BasedOn="{StaticResource HorizontalStackPanelInsideVertical}" TargetType="StackPanel" />

	<Style x:Key="RowLabels" BasedOn="{StaticResource VerticalStackPanel}" TargetType="StackPanel">
		<Setter Property="Margin" Value="0,0,8,0" />
		<Setter Property="LayoutTransform">
			<Setter.Value>
				<TranslateTransform Y="-50" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="LabelsScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}" TargetType="ScrollViewer">
		<Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
		<Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
	</Style>

	<Style x:Key="ColumnLabelsScrollViewer" BasedOn="{StaticResource LabelsScrollViewer}" TargetType="ScrollViewer">
		<Setter Property="m:ScrollViewerSyncScroll.Horizontal" Value="{Binding ElementName=ScrollViewer}" />
		<Setter Property="Margin">
			<Setter.Value>
				<MultiBinding Converter="{StaticResource ScrollViewerVisToMargin}">
					<Binding ElementName="ScrollViewer" />
					<Binding Path="ComputedVerticalScrollBarVisibility" ElementName="ScrollViewer" />
				</MultiBinding>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RowLabelsScrollViewer" BasedOn="{StaticResource LabelsScrollViewer}" TargetType="ScrollViewer">
		<Setter Property="m:ScrollViewerSyncScroll.Vertical" Value="{Binding ElementName=ScrollViewer}" />
		<Setter Property="Margin">
			<Setter.Value>
				<MultiBinding Converter="{StaticResource ScrollViewerVisToMargin}" ConverterParameter="{m:Bool True}">
					<Binding ElementName="ScrollViewer" />
					<Binding Path="ComputedHorizontalScrollBarVisibility" ElementName="ScrollViewer" />
				</MultiBinding>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="c:QuickSelectInterval2DEditor">
		<Setter Property="IsWide" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToWide}}" />
	</Style>

	<Style x:Key="Multiply" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
		<Setter Property="Text" Value="×" />
		<Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
		<Setter Property="Margin" Value="0,-4,0,0" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsWide, ElementName=View}" Value="False">
				<Setter Property="Visibility" Value="Collapsed" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
