<UserControl
	x:Class="OtomadHelper.WPF.Controls.QuickSelectInterval2DEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:OtomadHelper.WPF.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:m="clr-namespace:OtomadHelper.WPF.Common"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	mc:Ignorable="d"
	>
	<UserControl.DataContext>
		<c:QuickSelectInterval2DEditorViewModel />
	</UserControl.DataContext>

	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="./QuickSelectIntervalEditor.xaml" />
				<!--  TODO: May cause crush in VEGAS environment, not checked.  -->
			</ResourceDictionary.MergedDictionaries>
			<c:AlternationIndexToRowCellConverter x:Key="IndexToRowCell" />
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid
		Grid.Column="2"
		m:GridDef.Column="Auto,10,*"
		m:GridDef.Row="*,8,Auto,8,Auto,8,Auto,8,Auto"
		>
		<ScrollViewer
			Grid.ColumnSpan="3"
			FlowDirection="LeftToRight"
			HorizontalScrollBarVisibility="Visible"
			VerticalScrollBarVisibility="Visible"
			>
			<ItemsControl
				AlternationCount="{Binding Bits.Rows, FallbackValue=100}"
				Focusable="False"
				ItemsSource="{Binding Bits}"
				>
				<!--<ItemsControl.Resources>
					<CollectionViewSource x:Key="collectionViewSource" Source="{Binding Bits}" />
				</ItemsControl.Resources>
				<ItemsControl.ItemsSource>
					<CompositeCollection>
						<CollectionContainer Collection="{Binding Source={StaticResource collectionViewSource}}" />
						<Rectangle Style="{StaticResource RightTileShadow}">
							<Rectangle.Width>
								<MultiBinding Converter="{StaticResource CountToWidth}">
									<Binding Path="Bits.Count" />
									<Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=ScrollViewer, AncestorLevel=1}" />
								</MultiBinding>
							</Rectangle.Width>
							<Rectangle.Fill>
								<VisualBrush
									Opacity="0.35"
									Stretch="None"
									TileMode="Tile"
									Viewport="{Binding Bits.Count, Converter={StaticResource CountToViewport}}"
									ViewportUnits="Absolute"
									>
									<VisualBrush.Visual>
										<ItemsControl AlternationCount="{Binding Bits.Count, FallbackValue=100}" ItemsSource="{Binding Bits}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Style="{StaticResource HorizontalStackPanel}" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<ToggleButton Content="{Binding (ItemsControl.AlternationIndex), Mode=OneWay, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource AddOne}}" IsChecked="{Binding Path=., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</VisualBrush.Visual>
								</VisualBrush>
							</Rectangle.Fill>
						</Rectangle>
					</CompositeCollection>
				</ItemsControl.ItemsSource>-->
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Style="{StaticResource VerticalStackPanel}" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ItemsControl
							AlternationCount="{Binding Count, FallbackValue=100, Converter={StaticResource AddOne}}"
							Focusable="False"
							Tag="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource AddOne}}"
							>
							<ItemsControl.Resources>
								<CollectionViewSource x:Key="collectionViewSource" Source="{Binding}" />
							</ItemsControl.Resources>
							<ItemsControl.ItemsSource>
								<CompositeCollection>
									<TextBlock Style="{StaticResource RowLabel}" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
									<CollectionContainer Collection="{Binding Source={StaticResource collectionViewSource}}" />
								</CompositeCollection>
							</ItemsControl.ItemsSource>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Style="{StaticResource HorizontalStackPanelInsideVertical}" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<ToggleButton Command="{Binding DataContext.ToggleBooleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" IsChecked="{Binding ., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
										<ToggleButton.CommandParameter>
											<MultiBinding Converter="{StaticResource IndexToRowCell}">
												<Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
												<Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource Mode=TemplatedParent}" />
											</MultiBinding>
										</ToggleButton.CommandParameter>
									</ToggleButton>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<UniformGrid Grid.Row="2" Style="{StaticResource ActionButtonsGrid}">
			<c:Button
				Command="{Binding RestoreOriginalCommand}"
				IconName="ArrowReset"
				ToolTip="还原为设置前的选区"
				>
				还原
				<!--  TODO: I18n  -->
			</c:Button>
			<c:Button
				Command="{Binding InvertSelectionCommand}"
				IconName="InvertSelection"
				ToolTip="反转当前选区"
				>
				反选
				<!--  TODO: I18n  -->
			</c:Button>
			<c:Button
				Command="{Binding SelectNoneCommand}"
				Content="{m:Trans TextBox.Menu.ClearAll}"
				IconName="SelectNone"
				ToolTip="取消选中所有项目"
				/>
		</UniformGrid>

		<StackPanel
			Grid.Row="4"
			Grid.Column="0"
			Style="{StaticResource FormIconAndLabel}"
			>
			<c:Icon IconName="OddColumns" />
			<TextBlock x:Name="ColumnsLbl">列数</TextBlock>
			<!--  TODO: I18n  -->
		</StackPanel>
		<c:NumericUpDown
			Grid.Row="4"
			Grid.Column="2"
			m:NumberTextBoxBehavior.Range="1,100"
			AutomationProperties.LabeledBy="{Binding ElementName=ColumnsLbl}"
			Text="{Binding Bits.Columns, UpdateSourceTrigger=PropertyChanged}"
			/>

		<StackPanel
			Grid.Row="6"
			Grid.Column="0"
			Style="{StaticResource FormIconAndLabel}"
			>
			<c:Icon IconName="OddRows" />
			<TextBlock x:Name="RowsLbl">行数</TextBlock>
			<!--  TODO: I18n  -->
		</StackPanel>
		<c:NumericUpDown
			Grid.Row="6"
			Grid.Column="2"
			m:NumberTextBoxBehavior.Range="1,100"
			AutomationProperties.LabeledBy="{Binding ElementName=RowsLbl}"
			Text="{Binding Bits.Rows, UpdateSourceTrigger=PropertyChanged}"
			/>

		<StackPanel
			Grid.Row="8"
			Grid.Column="0"
			Style="{StaticResource FormIconAndLabel}"
			>
			<c:Icon IconName="Rename" />
			<TextBlock x:Name="RenameLbl">名称</TextBlock>
		</StackPanel>
		<TextBox
			Grid.Row="8"
			Grid.Column="2"
			AutomationProperties.LabeledBy="{Binding ElementName=RenameLbl}"
			Text="{Binding Name}"
			/>
	</Grid>
</UserControl>
