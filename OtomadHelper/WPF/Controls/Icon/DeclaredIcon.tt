<#
	string t4Name = Path.GetFileNameWithoutExtension(Host.TemplateFile);
	string projectDir = Host.ResolveAssemblyReference("$(ProjectDir)");
	string iconsXamlPath = Path.Combine(projectDir, @"WPF\Themes\Icons.xaml");
	XDocument iconsXamlFileDoc = XDocument.Load(iconsXamlPath);
	XNamespace namespaceConrtols = iconsXamlFileDoc.Root.GetNamespaceOfPrefix("c"),
		namespaceXaml = iconsXamlFileDoc.Root.GetNamespaceOfPrefix("x");
	const string iconNamePrefix = "Icon:";
	IEnumerable<XElement> iconTemplates = iconsXamlFileDoc.Descendants(namespaceConrtols + "IconTemplate");
	IEnumerable<string> names = iconTemplates.Select(iconTemplate => {
		string iconName = iconTemplate.Attribute(namespaceXaml + "Key").Value;
		if (iconName.StartsWith(iconNamePrefix, StringComparison.InvariantCultureIgnoreCase))
			iconName = iconName.Substring(iconNamePrefix.Length);
		return iconName;
	});
#>

namespace OtomadHelper.WPF.Controls;

public enum <#= t4Name #> {
	None,
<# foreach (string name in names) { #>
	<#= name #>,
<# } #>
}
