{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"noImplicitAny": true,
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"strict": true,
		"lib": [
			"ESNext",
			"ESNext.AsyncIterable",
			"ES2015.Promise",
			"DOM",
			"DOM.Iterable",
			"WebWorker"
		],
		"types": [
			"node",
			"vite/client",
			"vite-plugin-svgr/client",
			"vite-plugin-glsl/ext",
			"vite-plugin-minify-lottie-json/client",
		],
		"jsx": "react-jsx",
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"allowUnreachableCode": true,
		"allowJs": true,
		"noErrorTruncation": true,
		"paths": {
			"assets/*": ["./src/assets/*"],
			"components/*": ["./src/components/*"],
			"views/*": ["./src/views/*"],
			"styles/*": ["./src/styles/*"],
			"types/*": ["./src/types/*"],
			"utils/*": ["./src/utils/*"],
			"locales/*": ["./src/locales/*"],
			"stores/*": ["./src/stores/*"],
			"hooks/*": ["./src/hooks/*"],
			"contexts/*": ["./src/contexts/*"],
			"helpers/*": ["./src/helpers/*"],
			"services/*": ["./src/services/*"],
			"hoc/*": ["./src/hoc/*"],
			"plugins/*": ["./src/plugins/*"],
			"classes/*": ["./src/classes/*"],
			"workers/*": ["./src/workers/*"],
			"shaders/*": ["./src/shaders/*"],
			"containers/*": ["./src/containers/*"],
			"web/*": ["./*"],
		},
		"plugins": [
			{
				"name": "@styled/typescript-styled-plugin",
				"validate": false,
			}
		],
		"verbatimModuleSyntax": true,
	},
	"include": [
		".", "src/**/.auto-import", "src/plugins/**/*.d.ts",
	],
	"exclude": [
		"node_modules", "dist",
	],
}
