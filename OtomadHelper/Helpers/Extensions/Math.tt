	public static string From(int length, Func<int, string> selector, Func<int, string> lastSelector) {
		StringBuilder sb = new();
		for (int i = 1; i <= length; i++)
			if (i != length) sb.Append(selector(i));
			else sb.Append(lastSelector(i));
		return sb.ToString();
	}
