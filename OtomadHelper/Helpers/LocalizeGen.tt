<#+
	public static object GetKeyByValue(OrderedDictionary dictionary, object valueToFind) {
		foreach (DictionaryEntry entry in dictionary)
			if (object.Equals(entry.Value, valueToFind))
				return entry.Key;
		return null;
	}

	public void AddKeyToDictionary(OrderedDictionary dictionary, OrderedDictionary subclasses, string key) {
		string[] splitted = key.Split('.');
		OrderedDictionary parent = dictionary;
		int i = 0;
		foreach (string layer in splitted) {
			if (new Regex(@"^\d").IsMatch(layer)) {
				break;
			} else if (i == splitted.Length - 1) {
				parent[layer] = key;
			} else {
				if (!parent.Contains(layer)) {
					OrderedDictionary child = [];
					parent[layer] = child;
					subclasses[string.Join("_", splitted.Take(i + 1))] = child;
				}
				parent = (OrderedDictionary)parent[layer];
			}
			i++;
		}
	}

	public string GetXmlDocumentation(Dictionary<string, string> strings, string key, string indent) {
		string translated = strings[key];
		if (string.IsNullOrEmpty(translated)) return string.Empty;
		translated = new Regex(@"\r\n|\n|\r").Replace(translated, "<br />\n");
		translated = new Regex(@"&([A-Za-z0-9])").Replace(translated, "<u>$1</u>");
		string lines = string.Join("\n", $"<summary>\n{translated}\n</summary>".Split('\n').Select(line => indent + line));
		return lines.Replace("\n", "\r\n");
	}
#>